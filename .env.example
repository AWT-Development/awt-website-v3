# URL pública do site (metadata e links canônicos)
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br

# Briefing por e-mail (Resend). Sem a chave, o briefing só segue pelo WhatsApp.
RESEND_API_KEY=
# Destinatário (padrão: e-mail definido em src/content/site.ts)
BRIEFING_TO=
# Remetente verificado na Resend, ex.: "AWT Site <contato@seudominio.com.br>"
BRIEFING_FROM=
